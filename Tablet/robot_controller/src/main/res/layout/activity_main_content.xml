<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains the portion of activity_main.xml after the header card.
     It is included by the tablet-specific layout to avoid duplication. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_standard">

    <!-- Language Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Language"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_section_header"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="@dimen/margin_small" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="@dimen/margin_medium">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/radioButton_English"
            android:layout_width="0dp"
            android:layout_height="@dimen/language_button_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="🇺🇸 English"
            android:textAllCaps="false"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:backgroundTint="@color/languageSelected"
            android:textColor="@android:color/white"
            app:cornerRadius="18dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/radioButton_Mandarin"
            android:layout_width="0dp"
            android:layout_height="@dimen/language_button_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small"
            android:text="🇹🇼 Mandarin"
            android:textAllCaps="false"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:backgroundTint="@color/cardBackground"
            android:textColor="@color/textPrimary"
            app:strokeColor="@color/languageSelected"
            app:strokeWidth="2dp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- Session Controls -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session Controls"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_section_header"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="@dimen/margin_small" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStart"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#4CAF50">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="@dimen/text_size_icon_large"
                    android:textColor="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Session"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_button"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPause"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#FFC107">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏸"
                    android:textSize="@dimen/text_size_icon_large"
                    android:textColor="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_button"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        android:weightSum="2">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRepeat"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#2196F3">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄"
                    android:textSize="@dimen/text_size_icon_large"
                    android:textColor="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_button"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStop"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="#F44336">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏹"
                    android:textSize="@dimen/text_size_icon_large"
                    android:textColor="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_button"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Conversation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conversation"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_section_header"
        android:textColor="@color/textPrimary"
        android:layout_marginTop="@dimen/margin_extra_large"
        android:layout_marginBottom="@dimen/margin_small" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginBottom="@dimen/margin_small"
        app:cardCornerRadius="22dp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="@android:color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 Robot Conversation"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_section_header"
                android:textColor="@color/textPrimary" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="#DDDDDD" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerConversation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Session Progress -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session Progress"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_section_header"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="@dimen/margin_small" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="@dimen/margin_small">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtLessonProgress"
                android:text="Lesson 1 of 8"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_subtitle" />
            <ProgressBar
                android:id="@+id/progressSession"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_marginTop="@dimen/margin_small"
                android:max="8"
                android:progress="1" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Session Timer -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="@dimen/margin_extra_large">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/margin_large">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱"
                android:textSize="@dimen/text_size_icon_large" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Time"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_section_header" />
                <TextView
                    android:id="@+id/txtSessionTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="@dimen/text_size_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>