<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main App Theme -->
    <style name="Theme.TabletController" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/languageSelected</item>
        <item name="colorPrimaryVariant">@color/languageSelected</item>
        <item name="colorSecondary">@color/greenButton</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowBackground">@color/background</item>

    </style>

    <style name="RoundedButton">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">14dp</item>
    </style>

</resources>