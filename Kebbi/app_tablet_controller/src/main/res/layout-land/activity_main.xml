<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnNetworkSetting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network Setting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_restart"
        android:layout_width="558dp"
        android:layout_height="268dp"
        android:layout_marginStart="24dp"
        android:text="Restart"
        android:textSize="96sp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="29dp" />

    <RadioButton
        android:id="@+id/radioButton_Mandarin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:text="Mandarin"
        android:textSize="96sp"
        app:layout_constraintStart_toEndOf="@+id/btn_restart"
        tools:layout_editor_absoluteY="39dp" />

    <RadioButton
        android:id="@+id/radioButton_English"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="48dp"
        android:text="English"
        android:textSize="96sp"
        app:layout_constraintStart_toEndOf="@+id/btn_restart"
        app:layout_constraintTop_toBottomOf="@+id/radioButton_Mandarin" />
</androidx.constraintlayout.widget.ConstraintLayout>