<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_standard">

        <!-- Shared Header Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="@dimen/padding_standard">

                <ImageView
                    android:id="@+id/imgRobot"
                    android:layout_width="@dimen/robot_image_size"
                    android:layout_height="@dimen/robot_image_size"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cataract Education Assistant"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/textPrimary"
                    app:layout_constraintStart_toEndOf="@id/imgRobot"
                    app:layout_constraintTop_toTopOf="@id/imgRobot"
                    android:layout_marginStart="@dimen/margin_large" />

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your friendly robot assistant for cataract education"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textColor="#666666"
                    app:layout_constraintStart_toEndOf="@id/imgRobot"
                    app:layout_constraintTop_toBottomOf="@id/txtTitle"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_small" />

                <Button
                    android:id="@+id/btnNetworkSetting"
                    android:layout_width="@dimen/button_width"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/button_background"
                    android:text="📶 Connection"
                    android:textStyle="bold"
                    android:textColor="@color/greenButton"
                    android:textSize="@dimen/text_size_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Robot Status : Disconnected"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_section_header"
                    android:textColor="#E53935"
                    app:layout_constraintStart_toEndOf="@id/imgRobot"
                    app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_extra_large" />

                <!-- Robot State (connected/disconnected) -->
                <TextView
                    android:id="@+id/txtRobotState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Connected"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textColor="#4CAF50"
                    app:layout_constraintStart_toEndOf="@id/imgRobot"
                    app:layout_constraintTop_toBottomOf="@id/txtStatus"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_small" />

                <ImageView
                    android:id="@+id/imgEye"
                    android:layout_width="@dimen/eye_image_size"
                    android:layout_height="@dimen/eye_image_size"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="fitCenter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnNetworkSetting"
                    android:layout_marginTop="@dimen/margin_small" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Include the rest of the UI to avoid duplication -->
        <include layout="@layout/activity_main_content" />
    </LinearLayout>

</ScrollView>