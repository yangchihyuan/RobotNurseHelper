{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RobotNurseHelper",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/RobotNurseHelper",
      "args": ["--SettingFile", "json/ROGG16_Zenbo_English.json"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "sourceFileMap": {
        "${workspaceFolder}": "${workspaceFolder}"
      }
    }
  ]
}
